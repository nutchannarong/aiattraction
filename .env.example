# Supabase → Project Settings → API (server-only; the Vercel Supabase integration sets these)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: Google Maps Embed API key (restrict it to your domain in Google Cloud).
# Without it the map uses Google's keyless embed.
GOOGLE_MAPS_API_KEY=
