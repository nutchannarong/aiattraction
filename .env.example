# Supabase → Project Settings → API (server-only; the Vercel Supabase integration sets these)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: Google Maps Embed API key (restrict it to your domain in Google Cloud).
# Without it the map uses Google's keyless embed.
GOOGLE_MAPS_API_KEY=

# Admin reports: server-only, never use a NEXT_PUBLIC_ prefix.
# Use either the new Supabase secret key or legacy service-role key.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# OpenRouter AI (for AI trip highlights & assistant)
OPENROUTER_API_KEY=
# Optional: OpenRouter model id for the assistant (default google/gemini-3.8-flash)
# OPENROUTER_MODEL=
# Optional: OpenAI model on OpenRouter for per-route advice (default openai/gpt-5.4-mini)
# OPENROUTER_ROUTE_MODEL=
